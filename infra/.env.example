# Mal for infra/.env. Kopier fila og fyll inn:
#   cp infra/.env.example infra/.env
#
# infra/.env er dekket av .gitignore og skal aldri committes.
# Verdiene her er kun for lokal utvikling, og skal aldri gjenbrukes mot Neon.

POSTGRES_PASSWORD=utvikling
JOBB_NOKKEL=lokal-nokkel

# SMTP for kontaktskjemaet nar appen kjores i Docker. Se ADR 0014.
# Passordet er API-nokkelen fra Resend. Lim den inn i infra/.env, aldri her -
# denne fila er committet.
EPOST_SMTPHOST=smtp.resend.com
EPOST_BRUKER=resend
EPOST_PASSORD=
EPOST_AVSENDER=noreply@dyrepermen.no
EPOST_KONTAKTMOTTAKER=

# Vertsport for databasen. Standard er 5434 for a unnga kollisjon med en
# lokalt installert PostgreSQL pa 5432. Har du ingen slik, kan du sette 5432 -
# husk da a endre tilkoblingsstrengen i appsettings.Development.json ogsa.
POSTGRES_PORT=5434
