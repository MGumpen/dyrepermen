root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,csproj,props,targets,cshtml,html,css,js}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.cs]
indent_size = 4

# --- Kodestil, jf. CLAUDE.md ---
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
csharp_prefer_braces = true:suggestion
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Konstruktoerinjeksjon, ingen statisk tilstand
dotnet_style_readonly_field = true:warning
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning

# Navngiving
dotnet_naming_rule.private_felt_med_understrek.severity = warning
dotnet_naming_rule.private_felt_med_understrek.symbols = private_felt
dotnet_naming_rule.private_felt_med_understrek.style = understrek_camel

dotnet_naming_symbols.private_felt.applicable_kinds = field
dotnet_naming_symbols.private_felt.applicable_accessibilities = private
dotnet_naming_symbols.private_felt.required_modifiers = readonly

dotnet_naming_style.understrek_camel.required_prefix = _
dotnet_naming_style.understrek_camel.capitalization = camel_case
