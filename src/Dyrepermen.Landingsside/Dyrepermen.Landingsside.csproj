<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Ingen pakkereferanser. Alt landingssiden trenger ligger i
    rammeverket, og da finnes det heller ingen versjoner a holde styr pa.

    Innstillingene star her og ikke i Directory.Build.props, fordi denne
    branchen med vilje inneholder ett prosjekt og ingen losning.
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Dyrepermen.Landingsside</RootNamespace>
  </PropertyGroup>

</Project>
