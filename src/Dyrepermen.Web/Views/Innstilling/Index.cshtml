@using Dyrepermen.Domain.Enums
@model InnstillingerVm
@{
    ViewData["Tittel"] = "Innstillinger";
    var o = Model.Oversikt;
}

<div class="sidehode">
    <div>
        <h1>Innstillinger</h1>
        <div class="undertittel">
            Husstanden og det som deles. Dine egne innstillinger ligger under
            brukerkortet nederst i menyen.
        </div>
    </div>
</div>

<div class="dp-kolonner">
    <div class="kolonne">

        <section class="kort">
            <div class="kort-hode">
                <svg class="ikon ikon-lg" aria-hidden="true"><use href="#i-hjem" /></svg>
                <h2>Husstand</h2>
            </div>
            <div class="kort-kropp">
                <form method="post" asp-action="Lagre">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="alert alert-danger py-2" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Husstandsnavn" class="form-label"></label>
                        <input asp-for="Husstandsnavn" class="form-control" />
                        <span asp-validation-for="Husstandsnavn" class="text-danger small"></span>
                    </div>

                    <h3 class="h6 mt-3">Standardverdier for nye dyr</h3>
                    <p class="form-text mt-0">
                        Maler som kopieres inn når du oppretter et dyr. De
                        overstyrer aldri en bryter som allerede står på et dyr.
                    </p>

                    <div class="form-check form-switch mb-2">
                        <input asp-for="ForingsloggStandard" class="form-check-input" role="switch" />
                        <label asp-for="ForingsloggStandard" class="form-check-label"></label>
                    </div>
                    <div class="form-check form-switch mb-3">
                        <input asp-for="ForplanStandard" class="form-check-input" role="switch" />
                        <label asp-for="ForplanStandard" class="form-check-label"></label>
                    </div>

                    <h3 class="h6 mt-3">Varsler</h3>
                    <div class="form-check form-switch mb-3">
                        <input asp-for="VarslerAktiv" class="form-check-input" role="switch" />
                        <label asp-for="VarslerAktiv" class="form-check-label"></label>
                    </div>

                    <button type="submit" class="btn btn-primary btn-sm">Lagre</button>
                </form>
            </div>
        </section>

        <section class="kort">
            <div class="kort-hode">
                <svg class="ikon ikon-lg" aria-hidden="true"><use href="#i-medlemmer" /></svg>
                <h2>Medlemmer</h2>
                <span class="antall">@o.Medlemmer.Count</span>
            </div>

            <ul class="rad-liste">
                @foreach (var m in o.Medlemmer)
                {
                    <li>
                        <span class="flex-grow-1 min-w-0">
                            <span class="tittel">
                                @m.Visningsnavn
                                @if (m.ErDegSelv)
                                {
                                    <span class="merkelapp ms-1">deg</span>
                                }
                            </span>
                            <span class="under d-block">
                                @m.Epost ·
                                <strong>@(m.Rolle == Husstandsrolle.Beboer ? "Bor her" : "Gjest")</strong>
                            </span>
                        </span>
                        @* Alle medlemmer er likestilte i v1. Hvem som helst kan
                           fjerne hvem som helst - en bevisst begrensning, ikke
                           noe som er glemt. Se plan kapittel 12.6. *@
                        @if (o.Medlemmer.Count > 1)
                        {
                            <span class="hoyre">
                                <form method="post" asp-action="FjernMedlem"
                                      asp-route-brukerId="@m.BrukerId"
                                      onsubmit="return confirm('@(m.ErDegSelv ? "Forlate husstanden?" : $"Fjerne {m.Visningsnavn}?")');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-lenke-fare">
                                        @(m.ErDegSelv ? "Forlat" : "Fjern")
                                    </button>
                                </form>
                            </span>
                        }
                    </li>
                }
            </ul>

            @if (o.Ventende.Count > 0)
            {
                <div class="kort-kropp tett border-top">
                    <h3 class="h6 mb-0 mt-2">Venter på registrering</h3>
                </div>
                <ul class="rad-liste">
                    @foreach (var v in o.Ventende)
                    {
                        <li>
                            <span class="flex-grow-1 min-w-0">
                                <span class="tittel">@v.Epost</span>
                                <span class="under d-block">
                                    lagt til @($"{v.OpprettetDato:d. MMM yyyy}")
                                </span>
                            </span>
                            <span class="hoyre">
                                <form method="post" asp-action="AngreInvitasjon"
                                      asp-route-invitasjonId="@v.Id">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-lenke-fare">Angre</button>
                                </form>
                            </span>
                        </li>
                    }
                </ul>
            }

            <div class="kort-kropp border-top">
                <h3 class="h6">Legg til medlem</h3>
                <p class="form-text mt-0">
                    Personen blir med automatisk. Har de ikke konto ennå, skjer
                    det når de registrerer seg med denne adressen.
                </p>
                <form method="post" asp-action="LeggTilMedlem" class="row g-2">
                    @Html.AntiForgeryToken()
                    <div class="col-12 col-sm">
                        <input type="email" name="nyttMedlemEpost" class="form-control"
                               placeholder="navn@@eksempel.no" required />
                    </div>
                    <div class="col-7 col-sm-4">
                        <select name="rolle" class="form-select">
                            <option value="Beboer">Bor her</option>
                            <option value="Gjest">Gjest</option>
                        </select>
                    </div>
                    <div class="col-5 col-sm-auto">
                        <button type="submit" class="btn btn-outline-secondary btn-sm w-100">
                            Legg til
                        </button>
                    </div>
                    <div class="col-12">
                        <p class="form-text mt-0 mb-0">
                            <strong>Bor her</strong> — deler ansvaret og kan endre
                            alt. <strong>Gjest</strong> — passer dyra av og til:
                            ser alt og kan registrere vekt, fôring og doser, men
                            ikke endre dyr, medlemmer eller innstillinger.
                        </p>
                    </div>
                </form>
            </div>
        </section>
    </div>

    <div class="kolonne">
        <section class="kort">
            <div class="kort-hode">
                <svg class="ikon ikon-lg" aria-hidden="true"><use href="#i-dyr" /></svg>
                <h2>Dyrene</h2>
                <span class="antall">@o.AntallDyr</span>
                <a class="se-alle" asp-controller="Dyr" asp-action="Index">Se alle</a>
            </div>
            <div class="kort-kropp">
                <p class="small text-body-secondary mb-2">
                    Opplysninger og funksjonsbrytere redigeres på hvert dyr.
                </p>
                <a asp-controller="Dyr" asp-action="Index"
                   class="btn btn-outline-secondary btn-sm">Rediger dyr</a>
            </div>
        </section>

        <section class="kort">
            <div class="kort-hode">
                <svg class="ikon ikon-lg" aria-hidden="true"><use href="#i-informasjon" /></svg>
                <h2>Data</h2>
            </div>
            <div class="kort-kropp">
                <p class="small text-body-secondary mb-2">
                    Alt husstanden eier, som JSON.
                </p>
                <a asp-controller="MinKonto" asp-action="LastNedData"
                   class="btn btn-outline-secondary btn-sm">Last ned alle data</a>
            </div>
        </section>

        <section class="kort">
            <div class="kort-hode">
                <h2>Dine innstillinger</h2>
            </div>
            <div class="kort-kropp">
                <p class="small text-body-secondary mb-2">
                    Passord, e-post og sletting av egen konto ligger under
                    brukerkortet nederst i menyen — det er dine
                    personopplysninger, ikke husstandens delte data.
                </p>
                <a asp-controller="MinKonto" asp-action="Index"
                   class="btn btn-outline-secondary btn-sm">Min konto</a>
            </div>
        </section>
    </div>
</div>

@section Skript {
    <partial name="_ValidationScriptsPartial" />
}
