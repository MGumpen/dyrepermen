@using Dyrepermen.Application.Interfaces
@inject IGjeldendeBruker Meg
@model MinKontoVm
@{
    ViewData["Tittel"] = "Min konto";
    var s = Model.Slett;
}

<div class="sidehode">
    <div>
        <h1>Min konto</h1>
        <div class="undertittel">
            Dine personopplysninger. Husstandens innstillinger ligger under
            <a asp-controller="Innstilling" asp-action="Index">Innstillinger</a>.
        </div>
    </div>
</div>

<div style="max-width: 34rem;">
    <section class="kort">
        <div class="kort-hode">
            <svg class="ikon ikon-lg" aria-hidden="true"><use href="#i-medlemmer" /></svg>
            <h2>Profil</h2>
        </div>
        <ul class="rad-liste">
            <li>
                <span class="flex-grow-1">Visningsnavn</span>
                <span class="hoyre">@Meg.Visningsnavn</span>
            </li>
            <li>
                <span class="flex-grow-1">E-post</span>
                <span class="hoyre">@Meg.Epost</span>
            </li>
            <li>
                <span class="flex-grow-1">Husstand</span>
                <span class="hoyre">@Meg.HusstandNavn</span>
            </li>
        </ul>
        <div class="kort-kropp tett border-top">
            <p class="form-text mb-2">
                Endring av navn, e-post og passord kommer i en senere fase.
                E-post er innloggingsnavnet, så bytte krever bekreftelse på
                den nye adressen.
            </p>
        </div>
    </section>

    <section class="kort">
        <div class="kort-hode">
            <svg class="ikon ikon-lg" aria-hidden="true"><use href="#i-informasjon" /></svg>
            <h2>Data</h2>
        </div>
        <div class="kort-kropp">
            <p class="small text-body-secondary mb-2">
                Last ned alt før du sletter. Kostnaden er lav, angrefristen er null.
            </p>
            <a asp-action="LastNedData" class="btn btn-outline-secondary btn-sm">
                Last ned alle data
            </a>
        </div>
    </section>

    <section class="kort fare">
        <div class="kort-hode">
            <h2>Slett kontoen permanent</h2>
        </div>
        <div class="kort-kropp">
            <div asp-validation-summary="All" class="alert alert-danger py-2" role="alert"></div>

            <p class="small">
                Navn, e-post og passord slettes. <strong>Husstandens data
                består</strong> — vektlogger og behandlinger tilhører husstanden,
                ikke deg, og blir stående med «slettet bruker» der navnet ditt sto.
            </p>

            @if (s.ErSisteMedlem)
            {
                <div class="alert alert-danger py-2" role="alert">
                    <strong>Du er eneste medlem.</strong>
                    Sletting fjerner også husstanden og alle data om
                    @s.AntallDyr @(s.AntallDyr == 1 ? "dyr" : "dyr").
                </div>
            }

            <p class="form-text">
                Det finnes ingen angrefrist. Sletting er endelig.
            </p>

            <form method="post" asp-action="Slett">
                @Html.AntiForgeryToken()

                <div class="mb-2">
                    <label asp-for="Slett.Passord" class="form-label"></label>
                    @* Passord ma tastes pa nytt. Enheten kan sta ulast, og
                       vedvarende innlogging i 30 dager gjor dette viktigere,
                       ikke mindre viktig. *@
                    <input asp-for="Slett.Passord" class="form-control"
                           autocomplete="current-password" />
                    <span asp-validation-for="Slett.Passord" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Slett.Bekreftelse" class="form-label"></label>
                    <input asp-for="Slett.Bekreftelse" class="form-control"
                           autocomplete="off" placeholder="SLETT" />
                    <span asp-validation-for="Slett.Bekreftelse" class="text-danger small"></span>
                </div>

                @if (s.ErSisteMedlem)
                {
                    <div class="form-check mb-3">
                        <input asp-for="Slett.BekrefterHusstandsletting" class="form-check-input" />
                        <label asp-for="Slett.BekrefterHusstandsletting" class="form-check-label"></label>
                    </div>
                }

                <button type="submit" class="btn btn-danger btn-sm">
                    Slett kontoen min permanent
                </button>
            </form>
        </div>
    </section>

    <form method="post" action="/logg-ut" class="mt-3">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-outline-secondary btn-sm">Logg ut</button>
    </form>
</div>

@section Skript {
    <partial name="_ValidationScriptsPartial" />
}
