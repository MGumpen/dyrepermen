@using Dyrepermen.Application.Interfaces
@inject IGjeldendeBruker Meg
@{
    var innlogget = User.Identity?.IsAuthenticated == true && Meg.ErInnlogget;
    var gjeldende = ViewContext.RouteData.Values["controller"]?.ToString();

    string Aktiv(params string[] controllere) =>
        controllere.Any(c =>
            string.Equals(gjeldende, c, StringComparison.OrdinalIgnoreCase))
            ? "page" : "false";

    // To bokstaver fra visningsnavnet. "Marius Gundersen" gir MG.
    var initialer = string.Concat(
        (Meg.Visningsnavn ?? "")
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(d => char.ToUpperInvariant(d[0])));
}
<!DOCTYPE html>
<html lang="no">
<head>
    <meta charset="utf-8" />
    @* viewport-fit=cover kreves for at trygg sone pa iOS skal virke.
       Uten den havner utloggingsknappen under hjemindikatoren. *@
    <meta name="viewport"
          content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@ViewData["Tittel"] – Dyrepermen</title>
    <link rel="icon" href="~/img/logo.svg" />

    @* Stilene for oppstartsskjermen MA ligge inline. Ligger de i en ekstern
       fil, blinker det urenderte innholdet frem for overlegget far stil. *@
    <style>
        #oppstart {
            position: fixed; inset: 0; z-index: 9999;
            display: flex; flex-direction: column;
            align-items: center; justify-content: center; gap: 1rem;
            background: #f4f6f3;
            transition: opacity .25s ease;
        }
        #oppstart.skjult { opacity: 0; pointer-events: none; }
        #oppstart .spinner {
            width: 30px; height: 30px;
            border: 3px solid #dfe4dc; border-top-color: #2f6b46;
            border-radius: 50%;
            animation: snurr .8s linear infinite;
        }
        @@keyframes snurr { to { transform: rotate(360deg); } }
        @@media (prefers-reduced-motion: reduce) {
            #oppstart .spinner { animation: none; border-top-color: #dfe4dc; }
        }
    </style>
    <noscript>
        <style>#oppstart { display: none; }</style>
    </noscript>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div id="oppstart" role="status" aria-live="polite">
        <img src="~/img/logo.svg" alt="Dyrepermen" width="72" height="72" />
        <div class="spinner" aria-hidden="true"></div>
        <p class="text-body-secondary small">Laster …</p>
    </div>

    <partial name="_Ikoner" />

    @if (innlogget)
    {
        <nav class="topplinje d-lg-none">
            <a class="sidemeny-merke p-0" href="/">
                <img src="~/img/logo.svg" alt="" height="26" width="26" />
                <span>Dyrepermen</span>
            </a>
            <button class="btn btn-outline-secondary btn-sm" type="button"
                    data-bs-toggle="offcanvas"
                    data-bs-target="#hovedmeny"
                    aria-controls="hovedmeny"
                    aria-expanded="false"
                    aria-label="Åpne meny">
                <svg class="ikon" aria-hidden="true"><use href="#i-meny" /></svg>
            </button>
        </nav>

        <div class="dp-ramme">
            <div class="offcanvas-lg offcanvas-end sidemeny"
                 tabindex="-1" id="hovedmeny"
                 aria-labelledby="hovedmenyTittel">

                <div class="offcanvas-header d-lg-none">
                    <h2 class="offcanvas-title h6" id="hovedmenyTittel">Meny</h2>
                    @* data-bs-target ma sta ogsa her. Utelates den pa
                       lukkeknappen, lukkes ikke skuffen. *@
                    <button type="button" class="btn-close"
                            data-bs-dismiss="offcanvas"
                            data-bs-target="#hovedmeny"
                            aria-label="Lukk"></button>
                </div>

                <div class="offcanvas-body">
                    <a class="sidemeny-merke d-none d-lg-flex" href="/">
                        <img src="~/img/logo.svg" alt="" height="26" width="26" />
                        <span>Dyrepermen</span>
                    </a>

                    @* Husstandskortet: hvilken husstand du ser pa. Lenker til
                       husstandsinnstillingene - det er delte data. Dine egne
                       innstillinger ligger i brukerkortet nederst. *@
                    <a class="husstandskort" href="/innstillinger">
                        <span class="merke">
                            <svg class="ikon" aria-hidden="true"><use href="#i-hjem" /></svg>
                        </span>
                        <span class="min-w-0">
                            <span class="navn d-block">@Meg.HusstandNavn</span>
                            <span class="under">Husstand</span>
                        </span>
                    </a>

                    <ul class="sidemeny-nav">
                        <li>
                            <a href="/" aria-current="@Aktiv("Hjem")">
                                <svg class="ikon" aria-hidden="true"><use href="#i-oversikt" /></svg>
                                Oversikt
                            </a>
                        </li>
                        <li>
                            <a href="/dyr" aria-current="@Aktiv("Dyr", "Vekt", "Behandling", "Medisin", "Forplan")">
                                <svg class="ikon" aria-hidden="true"><use href="#i-dyr" /></svg>
                                Dyrene
                            </a>
                        </li>
                        <li>
                            <a href="/handleliste" aria-current="@Aktiv("Handleliste")">
                                <svg class="ikon" aria-hidden="true"><use href="#i-handleliste" /></svg>
                                Handleliste
                            </a>
                        </li>
                        <li>
                            <a href="/forsikring" aria-current="@Aktiv("Forsikring")">
                                <svg class="ikon" aria-hidden="true"><use href="#i-behandling" /></svg>
                                Forsikring
                            </a>
                        </li>
                        <li>
                            <a href="/informasjon" aria-current="@Aktiv("Informasjon")">
                                <svg class="ikon" aria-hidden="true"><use href="#i-informasjon" /></svg>
                                Informasjon
                            </a>
                        </li>
                        <li>
                            <a href="/innstillinger" aria-current="@Aktiv("Innstilling")">
                                <svg class="ikon" aria-hidden="true"><use href="#i-innstillinger" /></svg>
                                Innstillinger
                            </a>
                        </li>
                    </ul>

                    <div class="sidemeny-bunn">
                        @* Brukerkortet. Her ligger DINE innstillinger.
                           Skillet mot menyen over er eierskap:
                           personopplysninger mot husstandens delte data. *@
                        <a class="brukerkort" href="/konto">
                            <span class="initialer" aria-hidden="true">@initialer</span>
                            <span class="min-w-0">
                                <span class="navn d-block">@Meg.Visningsnavn</span>
                                <span class="epost d-block">@Meg.Epost</span>
                            </span>
                        </a>
                    </div>
                </div>
            </div>

            <main class="dp-innhold">
                @if (TempData["Melding"] is string melding)
                {
                    <div class="alert alert-success py-2" role="status">@melding</div>
                }
                @if (TempData["Feil"] is string feilmelding)
                {
                    <div class="alert alert-danger py-2" role="alert">@feilmelding</div>
                }
                @RenderBody()
            </main>
        </div>
    }
    else
    {
        <main class="apen-side">
            @RenderBody()
        </main>
    }

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/htmx/dist/htmx.min.js"></script>
    <script>
        // Skuffen lukkes av seg selv ved vanlig sidelast, men htmx bytter kun
        // en del av siden - da blir den staende apen over navigasjonen.
        // Se plan kapittel 10.2.
        document.body.addEventListener('htmx:afterOnLoad', function () {
            var meny = document.getElementById('hovedmeny');
            if (!meny) return;

            var skuff = bootstrap.Offcanvas.getInstance(meny);
            if (skuff) skuff.hide();
        });
    </script>
    <script>
        (function () {
            var o = document.getElementById('oppstart');
            if (!o) return;

            function skjul() {
                o.classList.add('skjult');
                setTimeout(function () { o.remove(); }, 300);
            }

            window.addEventListener('load', skjul);
            // Overlegget ma aldri kunne bli hengende om noe feiler.
            setTimeout(skjul, 8000);
        })();
    </script>
    @await RenderSectionAsync("Skript", required: false)
</body>
</html>
