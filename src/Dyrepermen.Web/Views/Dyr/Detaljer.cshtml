@using Dyrepermen.Application.Extensions
@model DyrDetaljerVm
@{
    var d = Model.Dyr;
    var s = Model.Sammendrag;
    ViewData["Tittel"] = d.Navn;
    var idag = DateOnly.FromDateTime(DateTime.Now);
}

<div class="sidehode">
    <div>
        <h1>@d.Navn</h1>
        <div class="undertittel">
            @d.Art@(d.Rase is null ? "" : $" · {d.Rase}")@(d.Fodselsdato is { } f
                ? $" · {Alderformat.Tekst(f, idag)}" : "")
        </div>
    </div>
    <div class="handlinger">
        <a asp-action="Rediger" asp-route-dyrId="@d.Id"
           class="btn btn-outline-secondary btn-sm">Rediger</a>
    </div>
</div>

<div class="dp-kolonner">
    <div class="kolonne">

        @* --- Opplysninger ----------------------------------------------- *@
        <section class="kort">
            <div class="kort-hode">
                <svg class="ikon ikon-lg" aria-hidden="true"><use href="#i-dyr" /></svg>
                <h2>Opplysninger</h2>
            </div>
            <div class="kort-kropp">
                <dl class="row mb-0 small">
                    <dt class="col-5 fw-normal text-body-secondary">Art</dt>
                    <dd class="col-7">@d.Art</dd>

                    <dt class="col-5 fw-normal text-body-secondary">Kjønn</dt>
                    <dd class="col-7">@d.Kjonn</dd>

                    <dt class="col-5 fw-normal text-body-secondary">Rase</dt>
                    <dd class="col-7">@(d.Rase ?? "—")</dd>

                    <dt class="col-5 fw-normal text-body-secondary">Født</dt>
                    <dd class="col-7">
                        @(d.Fodselsdato is { } fd ? $"{fd:d. MMMM yyyy}" : "—")
                    </dd>

                    <dt class="col-5 fw-normal text-body-secondary">Chipnummer</dt>
                    <dd class="col-7">@(d.ChipNr ?? "—")</dd>

                    @* Kun hund. En katt har ingen NKK-registrering, og en rad
                       som star tom for alltid leser som noe du har glemt. *@
                    @if (d.Art == Art.Hund)
                    {
                        <dt class="col-5 fw-normal text-body-secondary">NKK-regnr</dt>
                        <dd class="col-7">@(d.RegNrNkk ?? "—")</dd>
                    }

                    <dt class="col-5 fw-normal text-body-secondary">Kastrert</dt>
                    <dd class="col-7 mb-0">@(d.Kastrert ? "Ja" : "Nei")</dd>
                </dl>
            </div>
        </section>

        @* --- Vekt ------------------------------------------------------ *@
        <section class="kort">
            <div class="kort-hode">
                <svg class="ikon ikon-lg" aria-hidden="true"><use href="#i-vekt" /></svg>
                <h2>Vekt</h2>
                @if (s.AntallVekter > 0)
                {
                    <span class="antall">@s.AntallVekter</span>
                }
                <a class="se-alle" asp-controller="Vekt" asp-action="Index"
                   asp-route-dyrId="@d.Id">
                    @(s.AntallVekter > 0 ? "Se alle" : "Registrer")
                </a>
            </div>

            @if (s.SisteVektGram is { } gram)
            {
                <div class="kort-kropp">
                    <div class="dyrekort-tall mt-0">
                        <span>
                            <span class="verdi fs-5">@Vektformat.TilKiloTekst(gram)</span>
                            <span class="etikett">
                                målt @($"{s.SisteVektDato:d. MMMM yyyy}")
                            </span>
                        </span>
                    </div>
                </div>
            }
            else
            {
                @* Ikke "0 kg". Et tall uten dekning er verre enn ingen tall. *@
                <div class="tomt">Ingen vekt registrert.</div>
            }
        </section>

        @* --- Forplan ----------------------------------------------------
           Bryteren styrer visning OG tilgang. Er den av, gir controlleren
           404 - og da skal seksjonen heller ikke vises her. *@
        @if (d.ForplanAktiv)
        {
            <section class="kort">
                <div class="kort-hode">
                    <svg class="ikon ikon-lg" aria-hidden="true"><use href="#i-forplan" /></svg>
                    <h2>Fôrplan</h2>
                    <a class="se-alle" asp-controller="Forplan" asp-action="Index"
                       asp-route-dyrId="@d.Id">
                        @(s.ForplanTekst is null ? "Opprett" : "Se alle")
                    </a>
                </div>

                @if (s.ForplanTekst is { } plan)
                {
                    <div class="kort-kropp">
                        <div class="dyrekort-tall mt-0">
                            <span>
                                <span class="verdi fs-6">@plan</span>
                                <span class="etikett">gjeldende plan</span>
                            </span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="tomt">
                        Ingen fôrplan lagt inn. Appen anbefaler ikke mengde —
                        den regner ut regelen du legger inn.
                    </div>
                }
            </section>
        }
        @* --- Foring ------------------------------------------------------
           Bryteren styrer visning OG tilgang. Er den av, gir controlleren
           404 - og da skal seksjonen heller ikke vises her. *@
        @if (d.ForingsloggAktiv)
        {
            <section class="kort">
                <div class="kort-hode">
                    <svg class="ikon ikon-lg" aria-hidden="true"><use href="#i-forplan" /></svg>
                    <h2>Fôring</h2>
                    <a class="se-alle" asp-controller="Foring" asp-action="Index"
                       asp-route-dyrId="@d.Id">Se loggen</a>
                </div>
                <div class="kort-kropp">
                    <p class="mb-0 small text-body-secondary">
                        Logg hvem som ga mat og når, så slipper dere å spørre
                        hverandre.
                    </p>
                </div>
            </section>
        }

        @* --- Medisin ---------------------------------------------------- *@
        <section class="kort">
            <div class="kort-hode">
                <svg class="ikon ikon-lg" aria-hidden="true"><use href="#i-medisin" /></svg>
                <h2>Medisin</h2>
                @if (s.AktiveMedisiner.Count > 0)
                {
                    <span class="antall">@s.AktiveMedisiner.Count</span>
                }
                <a class="se-alle" asp-controller="Medisin" asp-action="Index"
                   asp-route-dyrId="@d.Id">
                    @(s.AntallMedisiner > 0 ? "Se alle" : "Legg til")
                </a>
            </div>

            @if (s.AktiveMedisiner.Count > 0)
            {
                <ul class="rad-liste">
                    @foreach (var m in s.AktiveMedisiner)
                    {
                        <li>
                            <span class="flex-grow-1 min-w-0">
                                <span class="tittel">@m</span>
                            </span>
                        </li>
                    }
                </ul>
            }
            else
            {
                <div class="tomt">
                    @(s.AntallMedisiner > 0
                        ? "Ingen aktive medisiner. Se historikken."
                        : "Ingen medisiner registrert.")
                </div>
            }
        </section>

        @* --- Behandlinger ---------------------------------------------- *@
        <section class="kort">
            <div class="kort-hode">
                <svg class="ikon ikon-lg" aria-hidden="true"><use href="#i-behandling" /></svg>
                <h2>Behandlinger</h2>
                @if (s.AntallBehandlinger > 0)
                {
                    <span class="antall">@s.AntallBehandlinger</span>
                }
                <a class="se-alle" asp-controller="Behandling" asp-action="Index"
                   asp-route-dyrId="@d.Id">
                    @(s.AntallBehandlinger > 0 ? "Se alle" : "Registrer")
                </a>
            </div>

            @if (s.NesteBehandlingDato is { } neste)
            {
                var forfalt = neste < idag;
                <ul class="rad-liste">
                    <li>
                        <span class="flex-grow-1 min-w-0">
                            <span class="tittel">@s.NesteBehandlingTekst</span>
                            <span class="under d-block">neste gang</span>
                        </span>
                        <span class="hoyre">
                            @if (forfalt)
                            {
                                <span class="merkelapp forfalt">forfalt</span>
                            }
                            <span class="d-block">@($"{neste:d. MMM yyyy}")</span>
                        </span>
                    </li>
                </ul>
            }
            else if (s.AntallBehandlinger > 0)
            {
                <div class="tomt">Ingen behandlinger med neste dato.</div>
            }
            else
            {
                <div class="tomt">Ingen behandlinger registrert.</div>
            }
        </section>

    </div>

    <div class="kolonne">

        @* --- Notater ----------------------------------------------------- *@
        <section class="kort">
            <div class="kort-hode">
                <svg class="ikon ikon-lg" aria-hidden="true"><use href="#i-informasjon" /></svg>
                <h2>Notater</h2>
                @if (s.AntallNotater > 0)
                {
                    <span class="antall">@s.AntallNotater</span>
                }
                <a class="se-alle" asp-controller="Informasjon" asp-action="Index">
                    @(s.AntallNotater > 0 ? "Se alle" : "Skriv et")
                </a>
            </div>
            @if (s.AntallNotater == 0)
            {
                <div class="tomt">
                    Ingenting notert om @d.Navn ennå.
                </div>
            }
            else
            {
                <div class="kort-kropp">
                    <p class="mb-0 small text-body-secondary">
                        @s.AntallNotater @(s.AntallNotater == 1 ? "notat" : "notater")
                        på informasjonssiden.
                    </p>
                </div>
            }
        </section>

        @* --- Funksjoner --------------------------------------------------- *@
        <section class="kort">
            <div class="kort-hode">
                <svg class="ikon ikon-lg" aria-hidden="true"><use href="#i-innstillinger" /></svg>
                <h2>Funksjoner</h2>
                <a class="se-alle" asp-action="Rediger" asp-route-dyrId="@d.Id">Endre</a>
            </div>
            <ul class="rad-liste">
                <li>
                    <span class="flex-grow-1">Fôringslogg</span>
                    <span class="hoyre">
                        <span class="merkelapp">@(d.ForingsloggAktiv ? "på" : "av")</span>
                    </span>
                </li>
                <li>
                    <span class="flex-grow-1">Fôrplan</span>
                    <span class="hoyre">
                        <span class="merkelapp">@(d.ForplanAktiv ? "på" : "av")</span>
                    </span>
                </li>
            </ul>
        </section>
    </div>
</div>
