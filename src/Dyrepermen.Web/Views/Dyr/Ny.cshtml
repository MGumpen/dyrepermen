@model NyttDyrVm
@{
    ViewData["Tittel"] = "Nytt dyr";
}

<div class="sidehode">
    <div>
        <h1>Nytt dyr</h1>
        <div class="undertittel">Chipnummer og regnummer kan stå tomt.</div>
    </div>
</div>

<section class="kort" style="max-width: 34rem;">
    <div class="kort-hode">
        <svg class="ikon ikon-lg" aria-hidden="true"><use href="#i-dyr" /></svg>
        <h2>Opplysninger</h2>
    </div>
    <div class="kort-kropp">
        <form method="post" asp-action="Ny">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="All" class="alert alert-danger py-2" role="alert"></div>

            <partial name="_Felter" model="Model" />

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm">Lagre</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Avbryt</a>
            </div>
        </form>
    </div>
</section>

@section Skript {
    <partial name="_ValidationScriptsPartial" />
}
