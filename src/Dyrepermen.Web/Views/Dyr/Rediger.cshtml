@model RedigerDyrVm
@{
    ViewData["Tittel"] = $"Rediger {Model.Navn}";
}

@* Hadde allerede en tilbakeknapp, men ute til hoyre og med bare "Tilbake" -
   som ikke sier hvor. Samme hode som de andre undersidene na. *@
<partial name="_Dyrhode" model='new DyrhodeVm("Rediger", Model.Id, Model.Navn)' />

<div style="max-width: 34rem;">
    @* Eget kort med egne skjemaer, utenfor redigeringsskjemaet: et skjema kan
       ikke ligge i et annet, og en valideringsfeil i navnet skal ikke koste
       bildet brukeren nettopp valgte. *@
    <section class="kort" id="profilbilde">
        <div class="kort-hode">
            <svg class="ikon ikon-lg" aria-hidden="true"><use href="#i-dyr" /></svg>
            <h2>Bilde</h2>
        </div>
        <div class="kort-kropp d-flex gap-3 align-items-start">
            <partial name="_Profilbilde"
                     model='new ProfilbildeVm(Model.ProfilbildeId, Model.Navn, "stor")' />
            <div class="flex-grow-1 min-w-0">
                <form method="post" asp-action="LagreProfilbilde" asp-route-dyrId="@Model.Id"
                      enctype="multipart/form-data" class="mb-2">
                    @Html.AntiForgeryToken()
                    <input class="form-control form-control-sm mb-2" type="file" name="bilde"
                           accept="image/*" aria-label="Velg bilde av @Model.Navn"
                           data-beskjaer="800" data-beskjaer-redigerer="beskjaer" required />

                    @* Vises nar et bilde er valgt. Sirkelen er utsnittet slik
                       det blir seende ut pa oversikten; det som lastes opp, er
                       kvadratet rundt den. Skjult uten skript - da lastes
                       originalen opp som den er. *@
                    <div id="beskjaer" class="beskjaer mb-2" hidden>
                        <div class="beskjaer-flate">
                            <canvas tabindex="0"
                                    aria-label="Utsnitt av bildet. Dra for å flytte. Piltastene flytter, pluss og minus zoomer."></canvas>
                            <span class="beskjaer-sirkel" aria-hidden="true"></span>
                        </div>
                        <label class="form-label small mb-0 mt-2" for="beskjaer-zoom">Zoom</label>
                        <input type="range" class="form-range" id="beskjaer-zoom"
                               min="1" max="4" step="0.01" value="1" />
                        <div class="form-text mt-0">
                            Dra bildet og zoom til @Model.Navn fyller sirkelen.
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm">
                        @(Model.ProfilbildeId is null ? "Last opp bilde" : "Bytt bilde")
                    </button>
                </form>
                @if (Model.ProfilbildeId is not null)
                {
                    <form method="post" asp-action="FjernProfilbilde" asp-route-dyrId="@Model.Id"
                          onsubmit="return confirm('Fjerne bildet av @Model.Navn?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-lenke-fare">Fjern bildet</button>
                    </form>
                }
                <p class="form-text mb-0">
                    Vises på oversikten, på siden til @Model.Navn og på
                    savnet-plakaten. Velg et bilde der hele dyret synes.
                </p>
            </div>
        </div>
    </section>

    <form method="post" asp-action="Rediger" asp-route-dyrId="@Model.Id">
        @Html.AntiForgeryToken()

        <section class="kort">
            <div class="kort-hode">
                <svg class="ikon ikon-lg" aria-hidden="true"><use href="#i-dyr" /></svg>
                <h2>Opplysninger</h2>
            </div>
            <div class="kort-kropp">
                <div asp-validation-summary="All" class="alert alert-danger py-2" role="alert"></div>
                <partial name="_Felter" model="Model" />
            </div>
        </section>

        @* Bryterne hoerer til dyret, og det er her brukeren er nar
           sporsmalet melder seg. /innstillinger har kun husstandsvalg. *@
        <section class="kort">
            <div class="kort-hode">
                <svg class="ikon ikon-lg" aria-hidden="true"><use href="#i-innstillinger" /></svg>
                <h2>Funksjoner for @Model.Navn</h2>
            </div>
            <div class="kort-kropp">
                <div class="form-check form-switch mb-2">
                    <input asp-for="ForingsloggAktiv" class="form-check-input" role="switch" />
                    <label asp-for="ForingsloggAktiv" class="form-check-label"></label>
                </div>
                <div class="form-check form-switch mb-2">
                    <input asp-for="ForplanAktiv" class="form-check-input" role="switch" />
                    <label asp-for="ForplanAktiv" class="form-check-label"></label>
                </div>
                <p class="form-text mb-0">
                    Slås en bryter av, skjules funksjonen — registrerte rader
                    slettes ikke.
                </p>
            </div>
        </section>

        <div class="d-flex gap-2 mt-3">
            <button type="submit" class="btn btn-primary btn-sm">Lagre</button>
            <a asp-action="Detaljer" asp-route-dyrId="@Model.Id"
               class="btn btn-outline-secondary btn-sm">Avbryt</a>
        </div>
    </form>

    @* Destruktiv handling skilles visuelt og ligger nederst - aldri ved
       siden av en lagre-knapp. Se plan kapittel 12.4. *@
    <section class="kort fare mt-4">
        <div class="kort-hode">
            <h2>Deaktiver</h2>
        </div>
        <div class="kort-kropp">
            <p class="small text-body-secondary">
                @Model.Navn skjules fra oversikten, men all historikk beholdes.
                Chipnummeret forblir registrert.
            </p>
            <form method="post" asp-action="Deaktiver" asp-route-dyrId="@Model.Id"
                  onsubmit="return confirm('Deaktivere @Model.Navn?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger btn-sm">
                    Deaktiver @Model.Navn
                </button>
            </form>
        </div>
    </section>
</div>

@section Skript {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/beskjaering.js" asp-append-version="true"></script>
}
