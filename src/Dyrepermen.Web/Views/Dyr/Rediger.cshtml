@model RedigerDyrVm
@{
    ViewData["Tittel"] = $"Rediger {Model.Navn}";
}

<h1 class="h4 mb-3">Rediger @Model.Navn</h1>

<div class="card mb-4" style="max-width: 40rem;">
    <div class="card-body">
        <form method="post" asp-action="Rediger" asp-route-dyrId="@Model.Id">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <partial name="_Felter" model="Model" />

            <hr />

            @* Bryterne hoerer til dyret, og det er her brukeren er nar
               sporsmalet melder seg. /innstillinger har kun husstandsvalg. *@
            <h2 class="h6">Funksjoner for dette dyret</h2>

            <div class="form-check form-switch mb-2">
                <input asp-for="ForingsloggAktiv" class="form-check-input" role="switch" />
                <label asp-for="ForingsloggAktiv" class="form-check-label"></label>
            </div>

            <div class="form-check form-switch mb-3">
                <input asp-for="ForplanAktiv" class="form-check-input" role="switch" />
                <label asp-for="ForplanAktiv" class="form-check-label"></label>
            </div>

            <div class="form-text mb-3">
                Slås en bryter av, skjules funksjonen — loggede rader slettes ikke.
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Lagre</button>
                <a asp-action="Detaljer" asp-route-dyrId="@Model.Id"
                   class="btn btn-outline-secondary">Avbryt</a>
            </div>
        </form>
    </div>
</div>

@* Destruktiv handling skilles visuelt og ligger nederst - aldri ved siden av
   en lagre-knapp. Se plan kapittel 12.4. *@
<div class="card border-danger" style="max-width: 40rem;">
    <div class="card-body">
        <h2 class="h6 text-danger">Deaktiver</h2>
        <p class="small text-body-secondary">
            Dyret skjules fra oversikten, men all historikk beholdes.
            Chipnummeret forblir registrert.
        </p>
        <form method="post" asp-action="Deaktiver" asp-route-dyrId="@Model.Id"
              onsubmit="return confirm('Deaktivere @Model.Navn?');">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-danger btn-sm">
                Deaktiver @Model.Navn
            </button>
        </form>
    </div>
</div>

@section Skript {
    <partial name="_ValidationScriptsPartial" />
}
