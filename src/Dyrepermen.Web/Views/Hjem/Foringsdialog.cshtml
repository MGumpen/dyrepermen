   dashbordet er lenker: href-en virker alene, hx-get er forbedringen. *@
<div class="sidehode">
    <div>
        <h1>@Model.Tittel</h1>
    </div>
</div>

<section class="kort kort-skjema">
    <partial name="_Foringsdialog" model="Model" />
</section>
