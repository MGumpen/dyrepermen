@using Dyrepermen.Web.ViewModels
@model VetbesokSkjemaVm
@{
    var ny = Model.Ny;
    var erNy = ny.Id is null;
    var erKontroll = erNy && ny.KontrollForBesokId is not null;
    var tittel = (erNy, erKontroll, ny.Gjennomfort) switch
    {
        (_, true, _) => "Ny kontrolltime",
        (true, _, true) => "Registrer besøk",
        (false, _, true) => "Registrer besøket",
        (true, _, _) => "Ny time",
        _ => "Rediger time"
    };
    ViewData["Tittel"] = tittel;
}

<div class="sidehode">
    <div>
        <h1>@tittel</h1>
        <div class="undertittel">
            @if (erKontroll)
            {
                @:Fylt ut fra besøket kontrollen ble avtalt på. Påminnelsen
                @:forsvinner fra oversikten når timen er lagt inn.
            }
            else if (!erNy && ny.Gjennomfort)
            {
                @:Fyll inn diagnose, pris og eventuell ny kontroll. Resten står
                @:som da timen ble lagt inn.
            }
            else if (ny.Gjennomfort)
            {
                @:Et besøk som allerede har vært. Velg dyret og veterinæren, og
                @:fyll inn det som kom ut av det.
            }
            else
            {
                @:En time i framtiden er «kommende». Har datoen passert, flyttes den
                @:til tidligere besøk av seg selv.
            }
        </div>
    </div>
</div>

<section class="kort">
    <div class="kort-kropp">
    @* multipart for vedleggene. Uten den sender nettleseren bare filnavnet. *@
    <form method="post" asp-action="LagreTime" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Ny.Id" />
        <input type="hidden" asp-for="Ny.KontrollForBesokId" />
        <input type="hidden" asp-for="Ny.Gjennomfort" />

        <div asp-validation-summary="All" class="alert alert-danger py-2" role="alert"></div>

        <div class="row g-3">
            <div class="col-12 col-md-5">
                <label asp-for="Ny.DyrId" class="form-label"></label>
                <select asp-for="Ny.DyrId" class="form-select"
                        asp-items="Model.DyrValg">
                    <option value="">Velg dyr</option>
                </select>
                <span asp-validation-for="Ny.DyrId" class="text-danger small"></span>
            </div>

            <div class="col-12 col-md-4">
                <label asp-for="Ny.Dato" class="form-label"></label>
                <input asp-for="Ny.Dato" class="form-control" type="date" />
                <span asp-validation-for="Ny.Dato" class="text-danger small"></span>
            </div>

            <div class="col-12 col-md-3">
                <label asp-for="Ny.Klokkeslett" class="form-label"></label>
                <input asp-for="Ny.Klokkeslett" class="form-control" type="time" />
                <div class="form-text">Valgfritt</div>
            </div>

            <div class="col-12 col-md-6">
                <label asp-for="Ny.VeterinarId" class="form-label"></label>
                <select asp-for="Ny.VeterinarId" class="form-select"
                        asp-items="Model.StedValg">
                    <option value="">— ikke valgt —</option>
                </select>
            </div>

            <div class="col-12 col-md-6">
                <label asp-for="Ny.Klinikk" class="form-label"></label>
                @* For steder som ikke star i listen - pa reise, eller den ene
                   gangen det hastet. Star begge, vinner det valgte stedet. *@
                <input asp-for="Ny.Klinikk" class="form-control"
                       placeholder="Brukes hvis stedet ikke står i listen" />
            </div>

            <div class="col-12">
                <label asp-for="Ny.Arsak" class="form-label"></label>
                <input asp-for="Ny.Arsak" class="form-control"
                       placeholder="Årskontroll og vaksine" />
                <span asp-validation-for="Ny.Arsak" class="text-danger small"></span>
            </div>

            <div class="col-12 col-md-6">
                <label asp-for="Ny.Diagnose" class="form-label"></label>
                @* Nar besoket registreres, er diagnosen det forste som
                   skal fylles inn. Markoren settes der. *@
                <input asp-for="Ny.Diagnose" class="form-control"
                       autofocus="@(ny.Gjennomfort ? "autofocus" : null)" />
            </div>

            <div class="col-12 col-md-6">
                <label asp-for="Ny.NesteKontrollDato" class="form-label"></label>
                <input asp-for="Ny.NesteKontrollDato" class="form-control" type="date" />
                <div class="form-text">Dukker opp i «Forfaller snart».</div>
            </div>
        </div>

        <h3 class="h6 mt-4">Økonomi</h3>
        <p class="form-text mt-0">
            Fylles ut etter besøket. En kommende time har ingen pris ennå.
        </p>

        <div class="row g-3">
            <div class="col-12 col-md-4">
                <label asp-for="Ny.KostnadKr" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="Ny.KostnadKr" class="form-control"
                           type="number" inputmode="numeric" min="0" step="1" />
                    <span class="input-group-text">kr</span>
                </div>
                <span asp-validation-for="Ny.KostnadKr" class="text-danger small"></span>
            </div>

            <div class="col-12 col-md-8 d-flex align-items-end">
                <div class="form-check form-switch mb-2">
                    <input asp-for="Ny.ForsikringKrevd" class="form-check-input"
                           role="switch" />
                    <label asp-for="Ny.ForsikringKrevd" class="form-check-label"></label>
                </div>
            </div>

            <div class="col-12 col-md-4">
                <label asp-for="Ny.RefundertKr" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="Ny.RefundertKr" class="form-control"
                           type="number" inputmode="numeric" min="0" step="1" />
                    <span class="input-group-text">kr</span>
                </div>
                @* Databasen har et CHECK-vilkar som avviser refusjon uten
                   krav. Tjenesten nuller feltet framfor a kaste. *@
                <div class="form-text">Krever at forsikring er huket av.</div>
                <span asp-validation-for="Ny.RefundertKr" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <label asp-for="Ny.Notat" class="form-label"></label>
                <textarea asp-for="Ny.Notat" class="form-control" rows="2"></textarea>
            </div>
        </div>

        @if (Model.KanLasteOpp)
        {
            <h3 class="h6 mt-4">Kvittering og vedlegg</h3>
            <div>
                @* image/* og ikke bare jpeg/png: pa mobil gir det valget mellom
                   kamera og bilder. Skriptet gjor bildet om til en nedskalert
                   jpeg for opplasting, og serveren avviser alt som ikke er
                   jpeg, png eller pdf uansett hva nettleseren sier. *@
                <input class="form-control" type="file" id="vedlegg" name="vedlegg"
                       accept="image/*,application/pdf" multiple
                       data-skaler-bilder />
                <div class="form-text" id="vedlegg-hjelp">
                    Ta bilde av kvitteringen, eller velg et bilde eller en PDF.
                    Du kan legge ved flere.
                </div>
            </div>
        }

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary btn-sm">
                @(erNy ? "Legg inn" : "Lagre")
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Avbryt</a>
        </div>
    </form>
    </div>
</section>

@* Utenfor skjemaet over: et skjema kan ikke ligge inne i et annet, og hvert
   vedlegg har sin egen sletteknapp. *@
@if (Model.Vedlegg.Count > 0)
{
    <section class="kort" id="vedlegg-liste">
        <div class="kort-hode">
            <svg class="ikon ikon-lg" aria-hidden="true"><use href="#i-vedlegg" /></svg>
            <h2>Vedlegg</h2>
            <span class="antall">@Model.Vedlegg.Count</span>
        </div>
        <ul class="rad-liste">
            @foreach (var v in Model.Vedlegg)
            {
                <li>
                    <a class="flex-grow-1 min-w-0 d-flex align-items-center gap-2"
                       asp-controller="Dokument" asp-action="Vis" asp-route-id="@v.Id"
                       target="_blank" rel="noopener">
                        @if (v.ErBilde)
                        {
                            <img class="vedlegg-miniatyr" loading="lazy" alt=""
                                 src="@Url.Action("Vis", "Dokument", new { id = v.Id })" />
                        }
                        else
                        {
                            <svg class="ikon ikon-lg" aria-hidden="true"><use href="#i-vedlegg" /></svg>
                        }
                        <span class="tittel text-truncate">@v.Navn</span>
                    </a>
                    <span class="hoyre">
                        <form method="post" asp-action="SlettVedlegg"
                              asp-route-besokId="@ny.Id" asp-route-dokumentId="@v.Id"
                              onsubmit="return confirm('Slette dette vedlegget?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-lenke-fare">Slett</button>
                        </form>
                    </span>
                </li>
            }
        </ul>
    </section>
}

@if (!erNy)
{
    <section class="kort" style="max-width: 34rem;">
        <div class="kort-hode">
            <h2>Slett timen</h2>
        </div>
        <div class="kort-kropp">
            <form method="post" asp-action="SlettTime" asp-route-id="@ny.Id">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger btn-sm"
                        onclick="return confirm('Slette denne timen?')">
                    Slett timen
                </button>
            </form>
        </div>
    </section>
}

@section Skript {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/bildeskalering.js" asp-append-version="true"></script>
}
