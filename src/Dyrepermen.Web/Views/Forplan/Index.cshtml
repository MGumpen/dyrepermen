@using Dyrepermen.Application.Extensions
@model ForplanSideVm
@{
    ViewData["Tittel"] = $"Fôrplan – {Model.DyrNavn}";
    var r = Model.Resultat;
}

<div class="sidehode">
    <div>
        <h1>Fôrplan</h1>
        <div class="undertittel">
            <a asp-controller="Dyr" asp-action="Detaljer" asp-route-dyrId="@Model.DyrId">
                @Model.DyrNavn
            </a>
        </div>
    </div>
</div>

<div class="dp-kolonner">
    <div class="kolonne">
        <section class="kort">
            <div class="kort-hode">
                <svg class="ikon ikon-lg" aria-hidden="true"><use href="#i-forplan" /></svg>
                <h2>I dag</h2>
            </div>

            @* Fire tilstander, spesifisert i plan kapittel 8.1.
               Ingen av dem skal vises som "0 gram". *@
            @if (!r.HarPlan)
            {
                <div class="tomt">
                    Ingen fôrplan lagt inn. Legg inn regelen du bruker, så
                    regner appen ut mengden.
                </div>
            }
            else if (r.ManglerVekt)
            {
                <div class="kort-kropp">
                    <div class="alert alert-warning py-2 mb-0" role="status">
                        <strong>Registrer en vekt for å regne ut mengden.</strong>
                        <div class="small mt-1">
                            Planen er prosentbasert, og da trengs det en
                            vektregistrering å regne fra.
                        </div>
                        <a asp-controller="Vekt" asp-action="Index"
                           asp-route-dyrId="@Model.DyrId"
                           class="btn btn-sm btn-outline-secondary mt-2">
                            Registrer vekt
                        </a>
                    </div>
                </div>
            }
            else
            {
                <div class="kort-kropp">
                    <div class="dyrekort-tall mt-0">
                        <span>
                            <span class="verdi fs-3">@r.GramPerDag g</span>
                            <span class="etikett">per dag</span>
                        </span>
                    </div>

                    @if (r.GrunnlagVektGram is { } grunnlag)
                    {
                        @* Vektgrunnlaget skal alltid vises sammen med
                           resultatet. Et tall uten synlig grunnlag er et tall
                           ingen tor stole pa. *@
                        <p class="form-text mb-0 mt-1">
                            Regnet fra @Vektformat.TilKiloTekst(grunnlag),
                            målt @($"{r.GrunnlagDato:d. MMM yyyy}")
                        </p>
                    }
                </div>

                <ul class="rad-liste border-top">
                    @for (var i = 0; i < Model.Maltider.Length; i++)
                    {
                        <li>
                            <span class="flex-grow-1">Måltid @(i + 1)</span>
                            <span class="hoyre"><strong>@Model.Maltider[i] g</strong></span>
                        </li>
                    }
                    <li>
                        <span class="flex-grow-1 text-body-secondary">Sum</span>
                        <span class="hoyre">@Model.Maltider.Sum() g</span>
                    </li>
                </ul>
            }
        </section>

        @if (Model.Aktiv is not null)
        {
            <section class="kort fare">
                <div class="kort-hode">
                    <h2>Deaktiver planen</h2>
                </div>
                <div class="kort-kropp">
                    <p class="small text-body-secondary">
                        Planen beholdes som historikk, men brukes ikke lenger.
                    </p>
                    <form method="post" asp-action="Deaktiver" asp-route-dyrId="@Model.DyrId"
                          onsubmit="return confirm('Deaktivere fôrplanen?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger btn-sm">
                            Deaktiver
                        </button>
                    </form>
                </div>
            </section>
        }
    </div>

    <div class="kolonne">
        <section class="kort">
            <div class="kort-hode">
                <svg class="ikon ikon-lg" aria-hidden="true"><use href="#i-pluss" /></svg>
                <h2>@(Model.Aktiv is null ? "Ny fôrplan" : "Erstatt planen")</h2>
            </div>
            <div class="kort-kropp">
                <p class="form-text mt-0">
                    Appen anbefaler ikke mengde. Den regner ut regelen du
                    legger inn.
                </p>

                <form method="post" asp-action="Ny" asp-route-dyrId="@Model.DyrId">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="All" class="alert alert-danger py-2" role="alert"></div>

                    <div class="mb-2">
                        <label asp-for="Ny.Metode" class="form-label"></label>
                        <select asp-for="Ny.Metode" class="form-select" id="metode">
                            <option value="Gram">Fast mengde i gram</option>
                            <option value="Prosent">Prosent av kroppsvekt</option>
                        </select>
                        <div class="form-text">
                            Prosentmetoden er levende: mengden følger vekten
                            automatisk. Fast mengde står stille.
                        </div>
                    </div>

                    <div class="mb-2" data-metode="Gram">
                        <label asp-for="Ny.GramPerDag" class="form-label"></label>
                        <input asp-for="Ny.GramPerDag" class="form-control"
                               inputmode="numeric" placeholder="gram" />
                        <span asp-validation-for="Ny.GramPerDag" class="text-danger small"></span>
                    </div>

                    <div class="mb-2" data-metode="Prosent">
                        <label asp-for="Ny.Prosent" class="form-label"></label>
                        <input asp-for="Ny.Prosent" class="form-control"
                               inputmode="decimal" placeholder="%" />
                        <span asp-validation-for="Ny.Prosent" class="text-danger small"></span>
                        <div class="form-text">Bruk komma: 5,0</div>
                    </div>

                    <div class="mb-2">
                        <label asp-for="Ny.AntallMaltider" class="form-label"></label>
                        <input asp-for="Ny.AntallMaltider" class="form-control"
                               inputmode="numeric" />
                        <span asp-validation-for="Ny.AntallMaltider" class="text-danger small"></span>
                    </div>

                    <div class="mb-2">
                        <label asp-for="Ny.Fornavn" class="form-label"></label>
                        <input asp-for="Ny.Fornavn" class="form-control" />
                        <span asp-validation-for="Ny.Fornavn" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Ny.Notat" class="form-label"></label>
                        <textarea asp-for="Ny.Notat" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="Ny.Notat" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary btn-sm">Lagre plan</button>
                </form>
            </div>
        </section>
    </div>
</div>

@section Skript {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Viser kun feltet som hoerer til valgt metode. Serveren nuller ut
        // det andre uansett, sa dette er ren opprydding i skjemaet.
        (function () {
            var velger = document.getElementById('metode');
            if (!velger) return;

            function oppdater() {
                document.querySelectorAll('[data-metode]').forEach(function (rad) {
                    rad.hidden = rad.dataset.metode !== velger.value;
                });
            }

            velger.addEventListener('change', oppdater);
            oppdater();
        })();
    </script>
}
