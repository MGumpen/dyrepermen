@model LoggInnVm
@{
    ViewData["Tittel"] = "Logg inn";
}

@* Minimal side: logo, e-post, passord, husk meg og to handlinger.
   Ingen markedsforing, ingen navigasjonsmeny. Se plan kapittel 11.2.

   Registrering var tidligere en gra smatekstlenke UNDER kortet, og folk
   fant den ikke. Den star na som en egen knapp i kortet, pa linje med
   innlogging: to veier videre, ikke en vei og en fotnote. *@
<div class="apen-kort">
    <div class="text-center mb-4">
        <img src="~/img/logo.svg" alt="" width="72" height="72" />
        <h1 class="h4 mt-3 mb-0">Dyrepermen</h1>
    </div>

    <div class="card">
        <div class="card-body">
            <form method="post" asp-action="LoggInn">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Epost" class="form-label"></label>
                    <input asp-for="Epost" class="form-control"
                           autocomplete="username" inputmode="email" autofocus />
                    <span asp-validation-for="Epost" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Passord" class="form-label"></label>
                    <input asp-for="Passord" class="form-control"
                           autocomplete="current-password" />
                    <span asp-validation-for="Passord" class="text-danger small"></span>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="HuskMeg" class="form-check-input" />
                    <label asp-for="HuskMeg" class="form-check-label"></label>
                </div>

                <button type="submit" class="btn btn-primary w-100">Logg inn</button>
            </form>

            <div class="skillelinje"><span>eller</span></div>

            @* Lenke, ikke knapp - den navigerer. Ser ut som en knapp fordi
               den er et likeverdig valg, ikke en fotnote. *@
            <a asp-action="Registrer" class="btn btn-aksent-omriss w-100">
                Opprett ny konto
            </a>
        </div>
    </div>
</div>

@section Skript {
    <partial name="_ValidationScriptsPartial" />
}
